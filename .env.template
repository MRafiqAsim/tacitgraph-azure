# TacitGraph (Azure) configuration.
# Copy to .env and fill in the values; .env is git-ignored.

# --- Azure OpenAI (LLM + embeddings) ---------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Search (vector + keyword retrieval) --------------------------
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=kg-chunks
AZURE_SEARCH_ENTITY_INDEX_NAME=kg-entities
AZURE_SEARCH_COMMUNITY_INDEX_NAME=kg-communities

# --- Azure Cosmos DB ----------------------------------------------------------
# Gremlin API holds the knowledge graph (GraphRAG local search)
COSMOS_GREMLIN_ENDPOINT=wss://<your-account>.gremlin.cosmos.azure.com:443/
COSMOS_GREMLIN_KEY=
COSMOS_DATABASE=email-kg
COSMOS_GRAPH=knowledge-graph
# NoSQL API (optional): chunks, communities, thread summaries
COSMOS_NOSQL_ENDPOINT=
COSMOS_NOSQL_KEY=

# --- ADLS Gen2 (pipeline data lake) -------------------------------------------
ADLS_STORAGE_ACCOUNT=
ADLS_CONTAINER=pipeline
# Account key or SAS token; leave empty to use DefaultAzureCredential
ADLS_STORAGE_KEY=
# Load the Gold graph from ADLS into memory for PathRAG path finding
USE_ADLS_GRAPH=true

# --- Pipeline behaviour -------------------------------------------------------
# Processing mode: local (spaCy/Presidio), llm (GPT-4o) or hybrid
PIPELINE_MODE=llm
# Set to false to process email bodies only
PROCESS_ATTACHMENTS=true
# Describe your corpus once; injected into every LLM system prompt
# PROMPT_DOMAIN_CONTEXT="You are analysing the email archive of an engineering team..."
# GraphRAG routing: auto, local or global
GRAPHRAG_SEARCH_TYPE=auto
# Global search: embedding (1 LLM call) or map_reduce (1 call per community)
GRAPH_RAG_GLOBAL_SEARCH_MODE=embedding
LOG_LEVEL=INFO

# --- Monitoring (optional) ----------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Paths (optional overrides) -----------------------------------------------
# TACITGRAPH_HOME=/path/to/repo
# TACITGRAPH_CONFIG_DIR=/path/to/config
